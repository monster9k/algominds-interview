// --- CONFIGURATION ---
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---
enum UserRole {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SessionStatus {
  PHASE_1_STRATEGY
  PHASE_2_IMPLEMENT
  COMPLETED
  ABANDONED
}

enum SubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  COMPILE_ERROR
  RUNTIME_ERROR
  TLE // Time Limit Exceeded
  MLE // Memory Limit Exceeded
}

enum MessageSender {
  AI
  USER
  SYSTEM
}

enum MessageType {
  TEXT
  CODE
  HINT
  FEEDBACK
}

enum ContestStatus {
  UPCOMING
  ONGOING
  FINISHED
}

enum ShopItemCategory {
  AVATAR_FRAME
  TITLE
  BADGE_COLOR
}

// --- MODELS ---

model User {
  id    String   @id @default(uuid())
  email String   @unique
  name  String
  role  UserRole @default(USER)

  // Auth Providers
  provider   String  @default("email") // "email", "google", "github"
  providerId String? // ID từ Google/GitHub (có thể null nếu dùng email/pass)
  password   String? // Password có thể null nếu đăng nhập bằng Google

  // Profile
  avatarUrl String?
  bio       String?
  isPro     Boolean @default(false)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete

  // Relations
  stats              UserStats?
  sessions           Session[]
  refreshTokens      RefreshToken[]
  questAttempts      QuestAttempt[]
  userBadges         UserBadge[]
  careerJourneys     CareerJourney[]
  personaUnlocks     UserPersonaUnlock[]
  contestSubmissions ContestSubmission[]
  userItems          UserItem[]
  discussPosts       DiscussPost[]
  discussComments    DiscussComment[]
  discussPostVotes   DiscussPostVote[]

  candidateInPeerSessions       PeerInterviewSession[] @relation("PeerInterviewCandidate")
  peerInterviewerInPeerSessions PeerInterviewSession[] @relation("PeerInterviewInterviewer")

  // Indexes
  @@index([provider, providerId])
  @@map("users") // Đổi tên bảng trong DB thành số nhiều (optional, chuẩn REST)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  jti       String    @unique
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model UserStats {
  id            String    @id @default(uuid())
  userId        String    @unique
  totalSessions Int       @default(0)
  totalSolved   Int       @default(0)
  averageScore  Float     @default(0)
  streakDays    Int       @default(0)
  lastActiveAt  DateTime?
  credits       Int       @default(10) // 10 lượt free

  // Store — xu (coin) kiếm được qua điểm danh hàng ngày + giải bài, KHÔNG
  // liên quan `credits` ở trên (đó là quota chat AI, đã có quyết định sản
  // phẩm từ trước là không đụng vào). `lastDailyRewardAt` dùng để chặn claim
  // quá 1 lần/ngày (so theo ngày UTC), độc lập với `streakDays`.
  coins             Int       @default(0)
  lastDailyRewardAt DateTime?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

model Problem {
  id         String     @id @default(uuid())
  displayId  Int        @unique @default(autoincrement())
  slug       String     @unique
  title      String
  difficulty Difficulty
  content    String // HTML Description

  // JSON Flexibility
  initialCode     Json // {ts: "...", py: "..."}
  solution        Json?
  // @deprecated — thay bằng sampleTestCases + hiddenTestCases (giữ tạm để rollback an toàn).
  testCases       Json?
  // Public/sample test case — hiển thị trên đề bài + dùng cho "Run". KHÔNG bao giờ chứa hidden case.
  sampleTestCases Json
  // Hidden test case — chỉ dùng nội bộ khi "Submit", KHÔNG được select ra bất kỳ response nào trả về client.
  hiddenTestCases Json?
  timeLimitMs     Int   @default(1000)
  memoryLimitMb   Int   @default(256)

  submitCount    Int   @default(0)
  passCount      Int   @default(0)
  acceptanceRate Float @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // NÂNG CẤP: Metadata cho việc chấm bài
  functionName          String                        @default("solution") // Tên hàm: "twoSum", "isValid"
  // (Optional) Input Type Signature để parse cho chuẩn C++
  // VD: ["number[]", "number"] -> Giúp convert JSON sang C++ Vector
  inputSignature        Json?
  // Relations
  tags                  ProblemTag[]
  sessions              Session[]
  companies             ProblemCompany[]
  careerTrackStages     CareerTrackStage[]
  careerTrackStagePools CareerTrackStageProblemPool[]
  peerInterviewSessions PeerInterviewSession[]
  contestProblems       ContestProblem[]
  contestSubmissions    ContestSubmission[]
  discussPosts          DiscussPost[]

  @@map("problems")
}

model Tag {
  id   String @id @default(uuid())
  name String @unique // "DP", "Graph"
  slug String @unique

  // Relations
  problems     ProblemTag[]
  discussPosts DiscussPostTag[]

  @@map("tags")
}

// Bảng trung gian Many-to-Many giữa Problem và Tag
model ProblemTag {
  problemId String
  tagId     String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([problemId, tagId])
  @@map("problem_tags")
}

model Company {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  createdAt DateTime @default(now())

  // Relations
  problems     ProblemCompany[]
  careerTracks CareerTrack[]

  @@map("companies")
}

// Bảng trung gian Many-to-Many giữa Problem và Company
model ProblemCompany {
  problemId String
  companyId String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([problemId, companyId])
  @@map("problem_companies")
}

model BugSnippet {
  id          String     @id @default(uuid())
  language    String // "javascript" | "python" | "java" — khớp PistonService.getLanguageConfig()
  difficulty  Difficulty
  code        String // toàn bộ đoạn code (nhiều dòng)
  buggyLine   Int // index dòng chứa bug, 0-based, tách theo "\n"
  explanation String? // hiện sau khi trả lời, giải thích bug là gì
  isActive    Boolean    @default(true) // để tắt câu hỏi lỗi mà không xoá (giữ lịch sử QuestAttempt tham chiếu được)
  createdAt   DateTime   @default(now())

  @@index([language, difficulty, isActive])
  @@map("bug_snippets")
}

model QuestAttempt {
  id           String     @id @default(uuid())
  userId       String
  difficulty   Difficulty
  score        Int
  correctCount Int
  wrongCount   Int
  bestCombo    Int
  durationMs   Int
  createdAt    DateTime   @default(now())

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeyProgress JourneyStageProgress?

  @@index([userId, createdAt])
  @@map("quest_attempts")
}

model Badge {
  id          String   @id @default(uuid())
  // Định danh ổn định dùng để đối chiếu earning-rule trong quest.service.ts —
  // tách khỏi `name` vì name là text hiển thị, có thể đổi/dịch sau này.
  key         String   @unique
  name        String
  description String
  iconKey     String // map sang lucide-react icon ở FE, không lưu SVG blob
  createdAt   DateTime @default(now())

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// --- CAREER JOURNEY MODELS ---

enum PersonaTone {
  STRICT
  FRIENDLY
  SKEPTICAL
  LENIENT
}

model InterviewerPersona {
  id                String      @id @default(uuid())
  key               String      @unique // "google_strict", "startup_friendly" — đối chiếu code, không đổi khi dịch tên hiển thị
  name              String
  description       String
  tone              PersonaTone
  systemPromptExtra String // đoạn chỉ dẫn NỐI VÀO systemInstruction gốc của AiService, không thay thế toàn bộ — giữ nguyên format JSON output bắt buộc
  unlockCost        Int         @default(0) // 0 = mặc định miễn phí (persona "Default" hiện tại)
  isActive          Boolean     @default(true)
  createdAt         DateTime    @default(now())

  stages  CareerTrackStage[]
  unlocks UserPersonaUnlock[]

  @@map("interviewer_personas")
}

// Store thay thế — mở khoá thuần qua tiến trình (PASSED ít nhất 1 stage dùng
// đúng persona này), KHÔNG đụng UserStats.credits — quyết định sản phẩm đã
// chốt với user khi bắt đầu implement mục này (xem ROADMAP.md mục P1).
model UserPersonaUnlock {
  id         String   @id @default(uuid())
  userId     String
  personaId  String
  unlockedAt DateTime @default(now())

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona InterviewerPersona @relation(fields: [personaId], references: [id], onDelete: Cascade)

  @@unique([userId, personaId])
  @@map("user_persona_unlocks")
}

model CareerTrack {
  id          String   @id @default(uuid())
  key         String   @unique // "senior_backend_startup", "newgrad_bigtech"
  name        String
  description String
  isActive    Boolean  @default(true)
  // Track mô phỏng pipeline của 1 công ty thật (P6) — optional, track
  // "generic" không gắn công ty nào vẫn hợp lệ, hành vi cũ giữ nguyên.
  companyId   String?
  createdAt   DateTime @default(now())

  company      Company?           @relation(fields: [companyId], references: [id])
  stages       CareerTrackStage[]
  journeys     CareerJourney[]
  hiringEvents HiringEvent[]

  @@map("career_tracks")
}

// Contest thay thế: cửa sổ thời gian giới hạn, 1 track "mở tuyển" — journey
// nào start track qua sự kiện này (`POST /career/events/:id/enter`) thì gắn
// eventId, tính vào bảng xếp hạng của sự kiện đó.
model HiringEvent {
  id        String   @id @default(uuid())
  trackId   String
  opensAt   DateTime
  closesAt  DateTime
  createdAt DateTime @default(now())

  track   CareerTrack     @relation(fields: [trackId], references: [id])
  entries CareerJourney[]

  @@map("hiring_events")
}

enum StageKind {
  PROBLEM // vòng dùng luồng sessions hiện có (Phase1 → Phase2)
  QUEST // vòng dùng mini-game Quest hiện có
  PEER_INTERVIEW // vòng Behavioral dùng Live Co-Interview thật (P6, xem PeerInterviewSession)
}

model CareerTrackStage {
  id            String    @id @default(uuid())
  trackId       String
  order         Int // thứ tự vòng trong track, 0-based
  label         String // "Phone Screen", "Onsite - Round 1"...
  kind          StageKind
  problemId     String? // bắt buộc khi kind = PROBLEM
  personaId     String
  // Ngưỡng điểm tối thiểu (0-100) để auto-grade PASS stage này — P4. PROBLEM:
  // so với điểm trung bình 4 field Evaluation.scores. QUEST: so với tỉ lệ
  // đúng (correctCount/(correctCount+wrongCount))*100 — tự động hoá ở P5.
  passThreshold Int       @default(70)
  // true: bỏ qua problemId tĩnh, chọn bài động trong problemPool theo tag
  // yếu nhất của user (P5, xem career.service.ts#pickAdaptiveProblem).
  adaptive      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  track       CareerTrack                   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  problem     Problem?                      @relation(fields: [problemId], references: [id])
  persona     InterviewerPersona            @relation(fields: [personaId], references: [id])
  progress    JourneyStageProgress[]
  digest      StageDigest?
  problemPool CareerTrackStageProblemPool[]

  @@unique([trackId, order])
  @@map("career_track_stages")
}

// Pool bài ứng viên cho 1 stage adaptive (P5) — chỉ có ý nghĩa khi
// CareerTrackStage.adaptive = true. Problem thực sự được chọn cho từng user
// tính động lúc ensureStageSession() chạy, không cố định trước.
model CareerTrackStageProblemPool {
  stageId   String
  problemId String

  stage   CareerTrackStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  problem Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([stageId, problemId])
  @@map("career_track_stage_problem_pool")
}

// Discuss thay thế: tổng hợp các strategyAnswer đã APPROVED khác nhau của
// cùng problemId (qua job nền `debrief-queue`, xem career.processor.ts) —
// cache lại, KHÔNG generate mỗi lần user xem. 1 digest / stage vì mỗi stage
// map cứng 1 problemId (qua CareerTrackStage.problemId).
model StageDigest {
  id          String   @id @default(uuid())
  stageId     String   @unique
  content     String
  sourceCount Int // số strategyAnswer distinct đã dùng để tạo digest này — dùng để quyết định có cần tái tạo khi có thêm answer mới không
  generatedAt DateTime @default(now())

  stage CareerTrackStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("stage_digests")
}

enum JourneyStatus {
  IN_PROGRESS
  PASSED
  FAILED
  ABANDONED
}

enum StageStatus {
  PENDING
  ACTIVE
  PASSED
  FAILED
}

model CareerJourney {
  id         String        @id @default(uuid())
  userId     String
  trackId    String
  eventId    String? // set khi journey được tạo qua POST /career/events/:id/enter — dùng để tính leaderboard sự kiện
  status     JourneyStatus @default(IN_PROGRESS)
  startedAt  DateTime      @default(now())
  finishedAt DateTime?

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  track           CareerTrack             @relation(fields: [trackId], references: [id])
  event           HiringEvent?            @relation(fields: [eventId], references: [id])
  progress        JourneyStageProgress[]
  readinessReport JourneyReadinessReport?

  @@index([userId, status])
  @@index([eventId])
  @@map("career_journeys")
}

// Readiness Report (P7) — báo cáo AI tổng hợp cuối journey, sinh qua job nền
// khi journey đóng THẬT (PASSED hoặc give-up FAILED, không sinh khi mới
// retry) — xem career.listener.ts#handleJourneyFinished, career.processor.ts.
model JourneyReadinessReport {
  id          String   @id @default(uuid())
  journeyId   String   @unique
  content     String // text Gemini tổng hợp, KHÔNG markdown (đúng convention Offer Debrief — FE hiện text thuần)
  generatedAt DateTime @default(now())

  journey CareerJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@map("journey_readiness_reports")
}

model JourneyStageProgress {
  id                     String      @id @default(uuid())
  journeyId              String
  stageId                String
  sessionId              String?     @unique // set khi stage.kind = PROBLEM
  questAttemptId         String?     @unique // set khi stage.kind = QUEST
  status                 StageStatus @default(PENDING)
  completedAt            DateTime?
  // Tăng mỗi lần auto-grade (P4) đánh giá mà CHƯA đạt passThreshold — stage
  // không tự FAILED khi chưa đạt (quyết định sản phẩm: cho retry tới khi đạt),
  // chỉ dùng để FE hiện nút "Give up" sau lần thử đầu tiên.
  attemptCount           Int         @default(0)
  // Tên tag yếu nhất đã dẫn tới việc chọn problem này cho stage adaptive
  // (P5) — snapshot tại thời điểm tạo, null nếu stage không adaptive hoặc
  // chọn ngẫu nhiên do chưa đủ dữ liệu (cold start).
  pickedReasonTag        String?
  // set khi stage.kind = PEER_INTERVIEW, sau khi candidate chủ động tạo
  // phòng (không tự tạo lúc vào stage) — P6.
  peerInterviewSessionId String?     @unique

  journey              CareerJourney         @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  stage                CareerTrackStage      @relation(fields: [stageId], references: [id])
  session              Session?              @relation(fields: [sessionId], references: [id])
  questAttempt         QuestAttempt?         @relation(fields: [questAttemptId], references: [id])
  peerInterviewSession PeerInterviewSession? @relation(fields: [peerInterviewSessionId], references: [id])

  @@unique([journeyId, stageId])
  @@map("journey_stage_progress")
}

model Session {
  id        String        @id @default(uuid())
  userId    String
  problemId String
  status    SessionStatus @default(PHASE_1_STRATEGY)

  // Optimistic Locking
  version Int @default(1)

  // Phase 1 Data
  strategyAnswer   String?
  strategyFeedback String? // AI Review
  // "hedging" | "neutral" | "assertive" — Gemini tự đánh giá dựa trên cách
  // ứng viên diễn đạt câu trả lời được approve (Confidence Calibration Score).
  // String tự do (không phải Prisma enum) vì đây là output AI, validate ở
  // ai.processor.ts trước khi ghi, không validate ở tầng DB.
  confidenceSignal String?

  // Phase 2 Data
  currentCode     String?
  currentLanguage String  @default("typescript")

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  // Relations
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         Problem               @relation(fields: [problemId], references: [id])
  messages        Message[]
  submissions     Submission[]
  events          SessionEvent[]
  evaluation      Evaluation?
  journeyProgress JourneyStageProgress?

  @@index([userId, status])
  @@index([problemId])
  @@map("sessions")
}

model SessionEvent {
  id          String        @id @default(uuid())
  sessionId   String
  status      SessionStatus
  event       String // "START", "SUBMIT"...
  triggeredBy MessageSender
  createdAt   DateTime      @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("session_events")
}

model Message {
  id        String        @id @default(uuid())
  sessionId String
  sender    MessageSender
  type      MessageType   @default(TEXT)
  content   String

  // AI Info
  tokenUsage    Int?
  aiModel       String? // "gpt-4o"
  promptVersion String?

  phaseContext SessionStatus?
  metaData     Json?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("messages")
}

model Submission {
  id        String           @id @default(uuid())
  sessionId String
  code      String
  language  String
  status    SubmissionStatus

  passedTests     Int   @default(0)
  totalTests      Int   @default(0)
  executionTime   Int? // ms
  memoryUsage     Int? // kb
  testCaseResults Json? // Chi tiết từng case

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

model Evaluation {
  id        String @id @default(uuid())
  sessionId String @unique

  scores   Json // {logic: 80, cleanCode: 90}
  feedback String?
  pros     Json? // List string
  cons     Json? // List string

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("evaluations")
}

// --- P3: LIVE CO-INTERVIEW MODE (PEER INTERVIEW) ---
// Model hoàn toàn RIÊNG, không đụng Session/state machine PHASE_1/PHASE_2 —
// quyết định sản phẩm đã chốt ở ROADMAP.md mục P3 (Session.userId là FK duy
// nhất, không có chỗ cho người thứ 2 mà không sửa bảng trung tâm nhất hệ
// thống). AI không tham gia real-time trong lúc phòng hoạt động, chỉ chấm
// điểm 1 lần lúc kết thúc (job grade-peer-interview trên ai-queue có sẵn).

enum PeerSessionStatus {
  WAITING_FOR_PEER // vừa tạo, đợi người thứ 2 join bằng inviteCode
  ACTIVE
  COMPLETED
  ABANDONED
}

enum PeerRole {
  CANDIDATE
  PEER_INTERVIEWER
}

model PeerInterviewSession {
  id                String            @id @default(uuid())
  candidateId       String
  peerInterviewerId String? // null cho tới khi có người join
  problemId         String
  status            PeerSessionStatus @default(WAITING_FOR_PEER)
  inviteCode        String            @unique // share cho người thứ 2 join qua POST /peer-interviews/join/:inviteCode
  startedAt         DateTime          @default(now())
  endedAt           DateTime?

  candidate       User                     @relation("PeerInterviewCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  peerInterviewer User?                    @relation("PeerInterviewInterviewer", fields: [peerInterviewerId], references: [id])
  problem         Problem                  @relation(fields: [problemId], references: [id])
  messages        PeerInterviewMessage[]
  evaluation      PeerInterviewEvaluation?
  journeyProgress JourneyStageProgress?

  @@index([candidateId])
  @@index([peerInterviewerId])
  @@map("peer_interview_sessions")
}

model PeerInterviewMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      PeerRole // CANDIDATE hay PEER_INTERVIEWER gửi — không tái dùng MessageSender (enum đó gắn với Session/AI)
  senderId  String
  content   String
  createdAt DateTime @default(now())

  session PeerInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("peer_interview_messages")
}

model PeerInterviewEvaluation {
  id                      String   @id @default(uuid())
  sessionId               String   @unique
  candidateScore          Int
  candidateFeedback       String
  peerInterviewerScore    Int
  peerInterviewerFeedback String
  createdAt               DateTime @default(now())

  session PeerInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("peer_interview_evaluations")
}

// --- CONTEST MODULE ---

model Contest {
  id          String        @id @default(uuid())
  slug        String        @unique
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  status      ContestStatus @default(UPCOMING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  problems    ContestProblem[]
  submissions ContestSubmission[]

  @@map("contests")
}

// Bài tập gắn vào 1 contest kèm điểm số riêng cho contest đó (không suy ra từ
// Problem.difficulty mỗi lần — 1 bài có thể mang điểm khác nhau ở mỗi contest).
model ContestProblem {
  id        String @id @default(uuid())
  contestId String
  problemId String
  points    Int // Easy 100đ / Medium 300đ / Hard 500đ khi seed
  order     Int    @default(0) // thứ tự hiển thị A, B, C...

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id])

  @@unique([contestId, problemId])
  @@map("contest_problems")
}

// 1 dòng = 1 lần nộp bài trong 1 contest, dùng để dựng bảng xếp hạng.
// Tái dùng SubmissionStatus đã có thay vì tạo enum pass/fail riêng.
model ContestSubmission {
  id             String           @id @default(uuid())
  contestId      String
  userId         String
  problemId      String
  status         SubmissionStatus
  submittedAt    DateTime         @default(now())
  penaltyMinutes Int              @default(0) // phút phạt của riêng lần nộp này (0 nếu ACCEPTED)

  // Audit trail đầy đủ — ngang hàng với model Submission — để có lịch sử nộp
  // bài thật (xem lại code đã nộp, breakdown từng testcase) thay vì chỉ có
  // đủ dữ liệu tính leaderboard.
  code            String  @default("")
  language        String  @default("javascript")
  passedTests     Int     @default(0)
  totalTests      Int     @default(0)
  executionTime   Int? // ms
  memoryUsage     Int? // kb
  testCaseResults Json?

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id])

  @@index([contestId, userId])
  @@index([contestId, problemId])
  @@map("contest_submissions")
}

// --- STORE MODULE ---

model ShopItem {
  id          String           @id @default(uuid())
  // Định danh ổn định dùng để seed/upsert và đối chiếu logic mua/equip —
  // tách khỏi `name` (text hiển thị, có thể đổi/dịch sau này), cùng convention
  // với Badge.key.
  key         String           @unique
  name        String
  description String
  category    ShopItemCategory
  price       Int
  iconKey     String // map sang lucide-react icon hoặc mã màu ở FE, không lưu ảnh
  createdAt   DateTime         @default(now())

  users UserItem[]

  @@map("shop_items")
}

model UserItem {
  id          String   @id @default(uuid())
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())
  // Chỉ 1 item equipped/category — enforce ở service layer (unequip item
  // cùng category trước khi equip item mới), không ép bằng DB constraint.
  equipped    Boolean  @default(false)

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@map("user_items")
}

// --- DISCUSS MODULE ---
// Forum kiểu LeetCode Discuss — vừa là trang riêng /discuss, vừa gắn theo
// từng bài toán (problemId nullable: null = thảo luận chung, có giá trị =
// gắn 1 Problem cụ thể, hiện trong tab "Thảo luận" của problem đó).
// P0 cố tình giữ comment phẳng (không reply lồng nhau) và chỉ vote ở cấp
// post (không vote comment) — xem ROADMAP.md mục P2 cho phần mở rộng sau.

model DiscussPost {
  id           String    @id @default(uuid())
  authorId     String
  problemId    String?
  title        String
  content      String // markdown thô, render ở FE
  viewCount    Int       @default(0)
  upvoteCount  Int       @default(0)
  commentCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  author   User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  problem  Problem?          @relation(fields: [problemId], references: [id], onDelete: SetNull)
  tags     DiscussPostTag[]
  comments DiscussComment[]
  votes    DiscussPostVote[]

  @@index([problemId])
  @@index([createdAt])
  @@map("discuss_posts")
}

model DiscussComment {
  id        String    @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  post   DiscussPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("discuss_comments")
}

// Chống vote 2 lần trên cùng 1 bài — toggle bằng cách tạo/xoá row này (xem
// DiscussService.toggleVote), KHÔNG dùng bảng vote union post/comment chung
// vì cột FK nullable sẽ không unique đúng trên Postgres (NULL != NULL).
model DiscussPostVote {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  post DiscussPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("discuss_post_votes")
}

// Bảng trung gian Many-to-Many giữa DiscussPost và Tag (tái dùng model Tag
// đã có cho Problem thay vì tạo tag riêng cho discuss).
model DiscussPostTag {
  postId String
  tagId  String

  post DiscussPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("discuss_post_tags")
}
