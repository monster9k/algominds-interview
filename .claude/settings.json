{
  "permissions": {
    "allow": [
      "Bash(npm run start:dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run test)",
      "Bash(npm run test:watch)",
      "Bash(npm run test:cov)",
      "Bash(npm run test:e2e)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npx jest*)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma db push)",
      "Bash(npx prisma db seed)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(docker-compose up -d)",
      "Bash(docker-compose ps)",
      "Bash(docker-compose logs*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(docker-compose down -v)",
      "Bash(rm -rf*)"
    ]
  }
}
