PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/algominds?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
EXPIRES_IN="1d"

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

GEMINI_API_KEY="your-gemini-api-key"

REDIS_HOST=localhost
REDIS_PORT=6379

FRONTEND_URL=http://localhost:5173

# development | production — ảnh hưởng cờ `secure` của refresh-token cookie
NODE_ENV=development

PISTON_API_URL=http://localhost:2000/api/v2/execute
