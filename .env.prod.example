# Template cho .env.prod dùng bởi docker-compose.prod.yml trên VPS.
# Copy: cp .env.prod.example .env.prod   (rồi điền giá trị thật, KHÔNG commit .env.prod)

# --- Postgres ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=algominds

# --- Server (NestJS) ---
# DATABASE_URL / REDIS_HOST / REDIS_PORT / PISTON_API_URL không cần điền —
# docker-compose.prod.yml đã tự trỏ tới service nội bộ (postgres/redis/piston).
JWT_SECRET=
EXPIRES_IN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/auth/google/callback
GEMINI_API_KEY=
FRONTEND_URL=https://yourdomain.com
NODE_ENV=production
# Optional — để trống thì Sentry không init.
SENTRY_DSN=

# --- Client (Vite build args) ---
VITE_API_URL=https://api.yourdomain.com
VITE_SOCKET_URL=https://api.yourdomain.com
VITE_SENTRY_DSN=

# --- Caddy (reverse proxy + auto HTTPS) ---
CADDY_ACME_EMAIL=you@yourdomain.com
CLIENT_DOMAINS=yourdomain.com, www.yourdomain.com
API_DOMAIN=api.yourdomain.com
